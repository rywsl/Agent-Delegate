# ---- public address --------------------------------------------------------------------------
DELEGATE_DOMAIN=:80
DELEGATE_PUBLIC_URL=http://localhost

# ---- secrets (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))") --------
# Encrypts provider API keys stored in the database. Do not rotate casually.
DELEGATE_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me

# ---- accounts ----------------------------------------------------------------------------------
DELEGATE_ALLOW_REGISTRATION=true

# ---- model providers ---------------------------------------------------------------------------
# Keys and Base URLs can instead be managed in Admin -> Model providers. Backend values take precedence.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# GEMINI_API_KEY=
# GEMINI_BASE_URL=

# ---- task defaults -----------------------------------------------------------------------------
DELEGATE_AGENTS=anthropic,openai,gemini
DELEGATE_DEFAULT_AGENT=anthropic
DELEGATE_ANTHROPIC_MODELS=claude-sonnet-4-5,claude-opus-4-5,claude-haiku-4-5
DELEGATE_OPENAI_MODELS=gpt-5.1-codex,gpt-5.1
DELEGATE_GEMINI_MODELS=gemini-3-pro-preview,gemini-2.5-flash
DELEGATE_SANDBOXES=docker
DELEGATE_DEFAULT_SANDBOX=docker
DELEGATE_HARNESSES=sdk,claude-code,codex,gemini,grok,pi,deepseek
DELEGATE_DEFAULT_HARNESS=sdk
DELEGATE_DEFAULT_TIMEOUT=3600
DELEGATE_MAX_TIMEOUT=14400
DELEGATE_DEFAULT_MAX_TURNS=200
DELEGATE_LLM_REQUEST_TIMEOUT=300
DELEGATE_MAX_OUTPUT_TOKENS=8192
DELEGATE_PER_USER_CONCURRENCY=2

# Optional JSON maps for external harnesses, keyed by harness name. No external harness is installed
# in the default image. Build a dedicated image and point DELEGATE_SANDBOX_IMAGES to it.
# DELEGATE_SANDBOX_IMAGES={"claude-code":"delegate-sandbox:claude-code"}
# DELEGATE_HARNESS_COMMANDS={"grok":["grok","--prompt","{full_prompt}"]}

# ---- file transfer ---------------------------------------------------------------------------------
DELEGATE_MAX_UPLOAD_BYTES=536870912
DELEGATE_UPLOAD_TTL=86400
DELEGATE_DOWNLOAD_TTL=86400
DELEGATE_MAX_PATCH_INLINE_BYTES=16384
DELEGATE_MAX_OUTPUT_BYTES=536870912

# ---- sandbox -------------------------------------------------------------------------------------
SANDBOX_IMAGE=delegate-sandbox:latest
SANDBOX_MAX_CONCURRENT=4
SANDBOX_MEMORY=4g
SANDBOX_CPUS=2
SANDBOX_PIDS=1024
# SANDBOX_AGENT_ENV=KEY=VALUE

# ---- MCP gateway ----------------------------------------------------------------------------------
DELEGATE_MCP_DEFAULT_WAIT=100
