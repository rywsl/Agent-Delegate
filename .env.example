# ---- public address --------------------------------------------------------------------------
# ":80" serves plain HTTP on every host name; a real domain (e.g. delegate.example.com) gets HTTPS.
DELEGATE_DOMAIN=:80
# Used for audit links, signed download/upload URLs and the MCP setup hint. MCP lives at <url>/mcp.
DELEGATE_PUBLIC_URL=http://localhost

# ---- secrets (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))") --------
# Signs sessions and download links and encrypts stored new-api credentials. Do not rotate casually:
# stored mirror-account credentials become unreadable (they are re-minted automatically, but slowly).
DELEGATE_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
NEWAPI_SESSION_SECRET=change-me
# Root password for new-api's first-run setup (the site performs the setup and keeps a scoped PAT).
NEWAPI_ROOT_PASSWORD=change-me-strong
# Pin the image: billing reconciliation reads new-api's log schema (other.usage_semantic /
# other.input_tokens_total), so an unexpected upgrade silently skews the token figures.
# Verified working:
#   NEWAPI_IMAGE=calciumion/new-api@sha256:938fa2713d4946723c9e9ce3076351c33f7770699fec92d23f3a26fd95791026
# NEWAPI_IMAGE=calciumion/new-api:latest

# ---- accounts & billing ---------------------------------------------------------------------------
DELEGATE_ALLOW_REGISTRATION=true
DELEGATE_SIGNUP_CREDIT_USD=0
DELEGATE_MIN_BALANCE_USD=0.10
# new-api group mirror accounts are placed in (group ratios are configured in new-api).
NEWAPI_USER_GROUP=default

# ---- task policy -------------------------------------------------------------------------------
DELEGATE_AGENTS=claude,codex,gemini,grok,pi,deepseek
DELEGATE_DEFAULT_AGENT=claude
# Models offered until an admin replaces the list in the console. They must exist in new-api.
DELEGATE_CLAUDE_MODELS=claude-sonnet-5-5,claude-opus-5-5,claude-haiku-5-5
DELEGATE_CODEX_MODELS=gpt-5.5-codex,gpt-5.5
DELEGATE_GEMINI_MODELS=gemini-3-pro-preview,gemini-2.5-flash
DELEGATE_GROK_MODELS=grok-4,grok-4-fast
DELEGATE_PI_MODELS=gpt-5.5,claude-sonnet-5-5
DELEGATE_DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-v4-flash
# Sandbox time (bring-your-own-key tasks) and the queue that keeps one account from crowding the host.
DELEGATE_SANDBOX_USD_PER_MINUTE=0.02
DELEGATE_FREE_SANDBOX_MINUTES=60
DELEGATE_MAX_QUEUED_TASKS=200
DELEGATE_MAX_QUEUED_PER_USER=8
# Named Docker volume that receives `delegate-admin update-clis`. Empty disables the overlay.
DELEGATE_HARNESS_VOLUME=delegate_harness_bin
# Model used for Claude Code's background requests (defaults to the task model).
# DELEGATE_CLAUDE_SMALL_MODEL=claude-haiku-5-5
DELEGATE_DEFAULT_BUDGET_USD=5
DELEGATE_MAX_BUDGET_USD=50
DELEGATE_DEFAULT_TIMEOUT=3600
DELEGATE_MAX_TIMEOUT=14400
DELEGATE_DEFAULT_MAX_TURNS=200
DELEGATE_PER_USER_CONCURRENCY=2

# ---- file transfer ---------------------------------------------------------------------------------
DELEGATE_MAX_UPLOAD_BYTES=536870912
DELEGATE_UPLOAD_TTL=86400
DELEGATE_DOWNLOAD_TTL=86400
DELEGATE_MAX_PATCH_INLINE_BYTES=16384
DELEGATE_MAX_OUTPUT_BYTES=536870912

# ---- sandbox -------------------------------------------------------------------------------------
SANDBOX_IMAGE=delegate-sandbox:latest
SANDBOX_MAX_CONCURRENT=4
SANDBOX_MEMORY=4g
SANDBOX_CPUS=2
SANDBOX_PIDS=1024
# Optional: restrict per-task gateway keys to the sandbox subnet (comma-separated IPs/CIDRs).
# SANDBOX_ALLOWED_IPS=172.30.0.0/16
# Optional: extra environment for the agent CLIs, comma-separated KEY=VALUE.
# SANDBOX_AGENT_ENV=CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1

# ---- MCP gateway ----------------------------------------------------------------------------------
# Seconds one delegate_task/wait_task call blocks before returning "still running" (Claude Code moves
# MCP calls that take longer than ~2 minutes to the background).
DELEGATE_MCP_DEFAULT_WAIT=100
